services:
  installer:
    image: 666uos/songlib-tv-installer:0.1.3
    pull_policy: missing
    environment:
      ZEROCONF_ENABLED: "false" # songlib:mdns-env
      SONGLIB_ALLOWED_HOSTS: "<hosts>" # songlib:hosts
    ports:
      - "${wizard_port:-15533}:80" # songlib:port
    volumes:
      - "${TRIM_PKGVAR:-/var/apps/songlibtvinstaller/var}/data:/data"
      - /var/run/dbus/system_bus_socket:/var/run/dbus/system_bus_socket:ro # songlib:socket
      - /var/run/avahi-daemon/socket:/var/run/avahi-daemon/socket:ro # songlib:socket
    # 与 CI 发布的镜像对齐（根 Dockerfile、上游入口）：容器内以镜像默认用户运行，
    # 入口脚本需要写 /keep、$HOME/.config；真正的访问边界在应用自身的管理鉴权。
    security_opt: [no-new-privileges:true]
    ulimits:
      core: 0
    restart: unless-stopped
    healthcheck:
      test: [CMD, curl, --fail, --silent, http://127.0.0.1:80/ready]
      interval: 30s
      timeout: 5s
      retries: 3
    logging:
      driver: json-file
      options: {max-size: 5m, max-file: '2'}
