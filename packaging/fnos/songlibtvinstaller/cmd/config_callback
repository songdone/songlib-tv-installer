#!/bin/sh
# Called after the user saves 运行设置. Empty port = keep current port;
# empty password = keep current password; empty domains (vestigial) ignored.
# fnOS recreates the container from the rendered compose itself, so this
# callback only renders files - the platform's docker socket is not
# available to package scripts (permission denied, real-device finding).
set -eu
: "${TRIM_PKGVAR:?缺少飞牛应用数据目录}"
f=${TRIM_APPDEST:?}/docker/docker-compose.yaml
log="$TRIM_PKGVAR/info.log"
old_port=$(cat "$TRIM_PKGVAR/port" 2>/dev/null || printf 15533)

p=${wizard_port:-}
case $p in ''|*[!0-9]*) p=$old_port ;; esac
[ "$p" -ge 1024 ] && [ "$p" -le 65535 ] || p=$old_port

pw=${wizard_password:-}
changed=0
[ "$p" != "$old_port" ] && changed=1
[ -n "$pw" ] && changed=1
[ "$changed" = 1 ] || exit 0

# 新端口被其他服务占用时明确拒绝（exit 1 + TRIM_TEMP_LOGFILE 弹给用户）
if [ "$p" != "$old_port" ]; then
    hex=$(printf '%04X' "$p")
    if awk -v h=":$hex" '$4=="0A" && substr($2,length($2)-4)==h{f=1} END{exit !f}' /proc/net/tcp /proc/net/tcp6 2>/dev/null; then
        printf '管理端口 %s 已被其他服务占用，请换一个端口再保存。\n' "$p" > "${TRIM_TEMP_LOGFILE:-/dev/stderr}"
        exit 1
    fi
fi

# 改密码：写新 initial-password 并移除旧 hash，应用下次启动重新生成 hash
if [ -n "$pw" ]; then
    len=$(printf '%s' "$pw" | wc -c)
    if [ "$len" -ge 8 ] && [ "$len" -le 64 ]; then
        mkdir -p "$TRIM_PKGVAR/data/keys"
        printf '%s' "$pw" > "$TRIM_PKGVAR/data/keys/initial-password"
        chmod 600 "$TRIM_PKGVAR/data/keys/initial-password"
        rm -f "$TRIM_PKGVAR/data/keys/management-password.hash"
    fi
fi

sh "$(dirname "$0")/prepare"
printf '%s settings applied: port %s -> %s, password %s\n' "$(date '+%F %T')" "$old_port" "$p" "$([ -n "$pw" ] && echo changed || echo unchanged)" >> "$log"
exit 0
