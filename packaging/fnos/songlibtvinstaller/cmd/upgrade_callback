#!/bin/sh
# Upgrade: re-render so the platform's recreate picks up the new image tag and
# port. Same constraint as install: no docker socket in the callback.
set -eu
sh "$(dirname "$0")/prepare"
printf '%s upgrade: compose rendered for the platform\n' "$(date '+%F %T')" >> "$TRIM_PKGVAR/info.log" 2>/dev/null || true
exit 0
